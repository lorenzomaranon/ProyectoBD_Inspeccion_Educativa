'CURSO'
object "curso2627 : Curso" as curso2627 {
  Nombre = 2026-27
  DiasTotales = 4
  TarifaKm = 0,24
  PlusAlmuerzo = 20
}

'CITA'
object "c3 : Cita" as c3 {
  Num_solicitud = 3
  Fecha = 12/11/2026
  Hora = 10:00
  Titulo = Cambio de grupo de mi hijo sin avisar a la familia
  TextoSolicitud = «Mi hijo Daniel, de 4.º de Primaria, ha sido
    cambiado de grupo a mitad de curso sin que el centro nos lo
    comunicara ni nos diera explicaciones. El director, Julián
    Ferrer, firmó el cambio. Solicito una cita con la inspección.»
  DocumentaciónAdjunta = [escrito_a_direccion.pdf]
  Estado = Concertada
  Prioridad = media
  Procedencia = Portal_Citas
}

'VISITAS'
object "v3 : Visita" as v3 {
  Fecha = 18/11/2026
  HoraInicio = 10:00
  HoraFin = 12:00
  Estado = Finalizada
}
object "v4 : Visita" as v4 {
  Fecha = 18/11/2026
  HoraInicio = 13:15
  HoraFin = 14:45
  Estado = Finalizada
}
object "d3 : Desplazamiento" as d3 {
  HoraSalida = 08:45
  KmVuelta = 0
}
object "d4 : Desplazamiento" as d4 {
  HoraSalida = 12:15
  HoraLlegadaDomicilio = 16:05
  KmVuelta = 100
}
object "dt3 : Dieta" as dt3 {
  Almuerzo = false
  /Importe = 9,12 €
}
object "dt4 : Dieta" as dt4 {
  Almuerzo = true
  /Importe = 68,00 €
}
object "i3 : Informe" as i3 {
  Prioridad = media
  Observacion = El director reconoce que el cambio de grupo
    se hizo por ajuste de ratio y que no se comunicó a la
    familia. Se le requiere informar por escrito a Antonio y
    revisar el protocolo de comunicación.
}
object "i4 : Informe" as i4 {
  Prioridad = baja
  Observacion = Visita ordinaria de seguimiento sin incidencias.
}

'DÍAS DE ASUNTOS PERSONALES'
object "diasSergio : DiasAsuntosPersonales" as diasSergio {
  DiasSolicitados = 3
  /DiasRestantes = 1
}
object "diasPaula : DiasAsuntosPersonales" as diasPaula {
  DiasSolicitados = 0
  /DiasRestantes = 4
}
object "diasGloria : DiasAsuntosPersonales" as diasGloria {
  DiasSolicitados = 2
  /DiasRestantes = 2
}

'ENLACES: FAMILIA'
antonio -- daniel : responsableDe >
(antonio, daniel) .. tutelaAntonio

'ENLACES: CITA'
antonio -- c3 : solicita >
c3 -- daniel : trataSobre >
gloria -- c3 : atiende >

'ENLACES: ACTIVIDADES'
gloria "jefe" -- v3 : asigna >
gloria "jefe" -- v4 : asigna >
sergio "responsable" -- v3 : realiza >
sergio "responsable" -- v4 : realiza >
ceipAlbarizones -- v3 : recibe >
ceipFuenteClara -- v4 : recibe >
v3 *-- i3
v3 *-- d3 : existe >
v4 *-- i4
v4 *-- d4 : existe >
d3 *-- dt3 : requiere >
d4 *-- dt4 : requiere >

'ENLACES: CENTROS Y ZONAS'
antonio -- iesMarismas : trabajaEn >
isabel -- iesMarismas : trabajaEn >
isabel -- iesMarismas : esResponsable >
ceipAlbarizones -- daniel
julian -- ceipAlbarizones : trabajaEn >
julian -- ceipAlbarizones : esResponsable >
elisa -- ceipFuenteClara : trabajaEn >
elisa -- ceipFuenteClara : esResponsable >
z02 -- iesMarismas
z03 -- ceipAlbarizones
z03 -- ceipFuenteClara
gloria -- z03 : trabajaEn >
sergio -- z03 : trabajaEn >
paula -- z03 : trabajaEn >

'ENLACES: DÍAS DE ASUNTOS PERSONALES'
gloria -- curso2627
sergio -- curso2627
paula -- curso2627
(gloria, curso2627) .. diasGloria
(sergio, curso2627) .. diasSergio
(paula, curso2627) .. diasPaula

note right of antonio
  Un único objeto con dos clases (Persona solapada):
  profesor en iesMarismas y tutor legal de daniel,
  que estudia en ceipAlbarizones. Un solo DNI.
end note

note right of d4
  Kilometraje = KmDesdeCadiz (ceipFuenteClara) + KmVuelta (d4)
              = 100 + 100 = 200 km
  La ida se mide siempre desde Cádiz (RN-01),
  aunque Sergio salga de Jerez.
  200 km × 0,24 €/km (TarifaKm de curso2627) = 48,00 €
  16:05 excede las 15:00: + 20 € (PlusAlmuerzo)
  /Importe de dt4 = 68,00 € (RN-01, RN-02)
end note

note right of d3
  Kilometraje = KmDesdeCadiz (ceipAlbarizones) + KmVuelta (d3)
              = 38 + 0 = 38 km
  KmVuelta = 0: Sergio no vuelve, sigue a Espera.
  38 km × 0,24 €/km = 9,12 €
  Sin HoraLlegadaDomicilio ni PlusAlmuerzo (R-08)
end note

note right of i3
  i3 e i4 los cumplimenta sergio porque es el
  responsable de v3 y v4 (R-03): no hay enlace
  propio Inspector-Informe.
end note

note top of ceipAlbarizones
  El informe i3 es de prioridad media y el centro
  pasa de baja a media: no llega a alta o urgente,
  así que no hay aviso (RC-03, RC-04)
end note

note bottom of diasSergio
  DiasRestantes = curso2627.DiasTotales - DiasSolicitados (R-10).
  Solo sergio consulta diasSergio y paula diasPaula.
  gloria, como inspectora jefe, consulta los tres (RN-06).
  RN-06 es una regla de acceso: no se ve en el diagrama.
end note

@enduml
