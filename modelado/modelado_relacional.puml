@startuml modelado_relacional
hide methods
skinparam ClassAttributeIconSize 0


entity "Centros Educativos" as CentrosEducativos {
    Identificacion: int <<PK>>
    --
    Nombre: string <<AK>>
    Zona: int <<FK>> -> Zonas
    Ubicacion: string
    Prioridad: e_Prioridad
    KmDesdeCadiz: real
}

entity DocumentosCita {
    Num_solicitud: int <<PK>> <<FK>> -> Citas
    DocumentacionAdjunta : string <<PK>>
    --   
}

entity Citas {
    Num_solicitud: int <<PK>> 
    --
    Fecha [0..1]: date
    Hora [0..1]: time
    Titulo: string
    TextoSolicitud: string
    Estado: e_EstadoCita
    Prioridad: e_Prioridad [0..1]
    Procedencia: e_Procedencia
    Tutor: int <<FK>> -> TutoresLegales
    Alumno: int <<FK>> -> Alumnos
    Inspector: int <<FK>> [0..1] -> Inspectores
}

entity Anotaciones {
    oid_Anotacion: int <<PK>>
    --
    Fecha: date
    Titulo: string
    Descripcion: string
    Prioridad: e_Prioridad
    Inspector: int <<FK>> -> Inspectores
    Centro: int <<FK>> -> CentrosEducativos
}

entity Visitas {
    oid_Visita: int <<PK>>
    --
    Fecha : date
    HoraInicio : time
    HoraFin : time [0..1]
    Estado : e_EstadoVisita
    Responsable : int <<FK>> -> Inspectores
    Jefe : int <<FK>> -> Inspectores
    Centro : int <<FK>> -> CentrosEducativos
}

entity Informes {
    oid_Visita : int <<PK>> <<FK>> -> Visitas
    --
    Prioridad : e_Priorida
    Observacion : text
}

entity Tareas {
    oid_Tarea : int <<PK>>
    --
    Fecha : date
    HoraInicio : time
    HoraFin : time [0..1]
    Descripcion : text
    Responsable : int <<FK>> -> Inspectores
    Jefe : int <<FK>> -> Inspectores
}

entity Zonas {
    Codigo: int <<PK>>
    --
    Nombre: string <<AK>>
}

entity Personas {
    oid_Persona: int <<PK>>
    --
    DNI: string <<AK>>
    Nombre: string
    Apellidos: string
}

entity Inspectores {
    oid_Persona: int <<PK>> <<FK>> -> Personas
    --
    esJefe: bool
    Zona: int <<FK>> -> Zonas
}

entity Alumnos {
    oid_Persona: int <<PK>> <<FK>> -> Personas
    --
    Centro: int <<FK>> -> CentrosEducativos
}

entity Profesores {
    oid_Persona: int <<PK>> <<FK>> -> Personas
    --
    Centro: int <<FK>> -> CentrosEducativos
    CentroResponsable: int <<FK>> <<AK>> [0..1] -> CentrosEducativos
}

entity AsignaturasProfesor {
    oid_Persona: int <<PK>> <<FK>> -> Profesores
    Asignatura: string <<PK>>
    --
}

entity TutoresLegales {
    oid_Persona: int <<PK>> <<FK>> -> Personas
    --
}

entity Tutelas {
    Tutor: int <<PK>> <<FK>> -> TutoresLegales
    Alumno: int <<PK>> <<FK>> -> Alumnos
    --
    Parentesco: e_Parentesco
}

Inspectores ||--o{ Visitas : realiza (Responsable)
Inspectores ||--o{ Visitas : asigna (Jefe)
Inspectores ||--o{ Tareas : realiza (Responsable)
Inspectores ||--o{ Tareas : asigna (Jefe)
CentrosEducativos ||--o{ Visitas : recibe
Visitas ||--o| Informes : contiene

entity Desplazamientos {
    oid_Visita: int <<PK>> <<FK>> -> Visitas
    --
    HoraSalida: time
    HoraLlegadaDomicilio: time [0..1]
    Origen: string [0..1]
    Destino: string [0..1]
    Km: real [0..1]
}

entity Dietas {
    oid_Visita: int <<PK>> <<FK>> -> Desplazamientos
    --
    Almuerzo: bool
}

Desplazamientos |o--||Visitas
Dietas |o--||Desplazamientos

entity DiasAsuntosPersonales {
    oid_DAP: int <<PK>>
    --
    Inspector: int <<FK>> <<AK1>> -> Inspectores
    Curso: string <<FK>> <<AK1>> -> Cursos
    DiasSolicitados: int
}

entity Cursos {
    Nombre: string <<PK>>
    --
    DiasTotales: int
    TarifaKm: real
    PlusAlmuerzo: real

}

DiasAsuntosPersonales }o--||Cursos
DiasAsuntosPersonales }o--||Inspectores

'------- ASOCIACIONES --------------------------------------
DocumentosCita }o--|| Citas

'------- REGLAS DE NEGOCIO ---------------------------------

note as RN01
  RN-01: El pago por kilometraje de un desplazamiento es su
  kilometraje, es decir, los kilómetros desde el centro de
  Cádiz hasta el centro visitado más los kilómetros de vuelta,
  multiplicado por la tarifa por kilómetro fijada para el
  curso en que se realiza, 0,24 €/km para el vigente.
end note

note as RN02
  RN-02: El plus de almuerzo es una cantidad fija por la
  comida del inspector, fijada para cada curso, 20 € para el
  vigente, y se añade a la dieta si y solo si la hora de
  llegada a su domicilio es posterior a las 15:00.
end note

note as RN03
  RN-03: El nivel de prioridad de un centro es la media de los
  niveles de prioridad de sus anotaciones, citas e informes,
  con la escala baja = 1, media = 2, alta = 3 y urgente = 4,
  redondeada al nivel más próximo. Solo cuentan las que tienen
  prioridad asignada: una cita pendiente de revisión o
  rechazada, o un informe sin prioridad, no entra en la media.
  La prioridad de un centro no se asigna a mano.
end note

note as RN04
  RN-04: El sistema debe evitar que una cita no finalizada y
  con fecha asignada tenga una fecha anterior a la actual.
end note

note as RN05
  RN-05: El sistema debe evitar que un inspector pueda tener
  en su calendario dos actividades que coincidan en fecha y
  hora de manera total o parcial.
end note

note as RN06
  RN-06: El sistema debe evitar que se registre el informe o
  el desplazamiento de una visita que no está finalizada.
end note

note as RN07
  RN-07: El sistema debe evitar que una visita finalizada
  vuelva a estar pendiente.
end note

note as RN08
  RN-08: El sistema debe evitar que figure como jefe de una
  visita o tarea un inspector que no sea inspector jefe
  (esJefe = verdadero).
end note

note as RN09
  RN-09: El sistema debe evitar que un tutor pida cita sobre
  un alumno del que no es tutor legal.
end note

note as RN10
  RN-10: El sistema debe evitar que una cita quede concertada
  sin fecha, hora o inspector.
end note

note as RN11
  RN-11: El sistema debe evitar que un inspector solicite más
  días de asuntos personales de los que le corresponden.
end note

note as RN12
  RN-12: El sistema debe evitar que se registre la hora de
  llegada al domicilio en un desplazamiento que no sea el
  último del día del inspector.
end note

note as RN13
  RN-13: El sistema debe obligar a que un centro tenga
  exactamente un profesor responsable, y que este trabaje
  en ese centro.
end note

note as RN14
  RN-14: El sistema debe evitar que una cita que no esté
  concertada tenga nivel de prioridad; ésta la asigna el
  inspector que atiende la cita.
end note

