@startuml modelado_relacional
hide methods
skinparam ClassAttributeIconSize 0


entity "Centros Educativos" as CentrosEducativos {
    Identificacion: int <<PK>>
    --
    Ubicacion
    Prioridad
    Zona: int <<FK>> -> Zonas
    ProfesorResponsable: int <<FK>> <<AK>> [0..1] -> Profesores
}


entity DocumentosCita {
    Num_solicitud: int <<PK>> <<FK>> -> Citas
    DocumentacionAdjunta : string <<PK>>
    --
     
}
entity Citas {
    Num_solicitud: int <<PK>> 
    --
    Fecha [0..1]
    Hora [0..1]
    Titulo
    TextoSolicitud
    Estado: e_EstadoCita
    Prioridad: e_Prioridad [0..1]
    Procedencia: e_Procedencia
    Tutor: int <<FK>> -> TutoresLegales
    Alumno: int <<FK>> -> Alumnos
    Inspector: int <<FK>> [0..1] -> Inspectores

}

entity Anotaciones {
    oid_Anotacion: int <<PK>>
    --
    Fecha
    Titulo
    Descripcion
    Prioridad: e_Prioridad
    Inspector: int <<FK>> -> Inspectores
    Centro: int <<FK>> -> CentrosEducativos
}



entity Visita {
    oid_Visita: int <<PK>>
    --
    *Fecha : date
    *HoraInicio : time
    *HoraFin : time
    *EstadoVisita : e_EstadoVisita
    *Responsable : int <<FK>> -> Inspectores
    *Jefe : int <<FK>> -> Inspectores
    *IdCentro : int <<FK>> -> CentrosEducativos
}

entity Informes {
    *oid_Informe : int <<PK>>
    --
    *Prioridad : e_Prioridad
    *Observacion : text
    *oid_Visita : int <<FK>> <<AK>> -> Visitas
}

entity Tareas {
    *oid_Tarea : int <<PK>>
    --
    *Fecha : date
    *HoraInicio : time
    *HoraFin : time
    *Descripcion : text
    *Responsable : int <<FK>> -> Inspectores
    *Jefe : int <<FK>> -> Inspectores
}



entity Zonas {
    Codigo: int <<PK>>
    --
    Nombre: string <<AK>>
    
}

entity Personas {
    oid_Persona: <<PK>>
    --
    DNI: <<AK>>
    Nombre
    Apellidos
}

entity Inspectores {
    oid_Persona: <<PK>> <<FK>> -> Personas
    --
    esJefe
    Codigo: <<FK>> -> Zonas
}
entity Alumnos {
    oid_Persona: <<FK>> <<PK>> -> Personas
    --
    Identificacion: <<FK>> -> CentrosEducativos
}

entity Profesores {
    oid_Persona: <<PK>> <<FK>> -> Personas
    --
    Identificacion: <<FK>> -> CentrosEducativos
}

entity AsignaturasProfesor {
    oid_Persona: <<PK>> <<FK>> -> Profesores
    Asignatura: <<PK>>
    --
}

entity TutoresLegales {
    oid_Persona: <<PK>> <<FK>> -> Personas
    --
}

entity Tutelas {
    tutor: int <<PK>> <<FK>> -> TutoresLegales
    alumno: int <<PK>> <<FK>> -> Alumnos
    --
    parentesco: e_Parentesco
}

Inspectores ||--o{ Visitas : realiza (Responsable)
Inspectores ||--o{ Visitas : asigna (Jefe)
Inspectores ||--o{ Tareas : realiza (Responsable)
Inspectores ||--o{ Tareas : asigna (Jefe)
CentrosEducativos ||--o{ Visitas : recibe
Visitas ||--o| Informes : contiene


entity Desplazamientos {
    oid_Visita: int <<PK>> <<FK>> -> Visitas
    --
    Origen: string
    Destino: string
    HoraSalida
    HoraLlegadaDomicilio [0..1]
    Kilometros: int
    TarifaK: float
}


entity Dietas {
    oid_Visita: int <<PK>> <<FK>> -> Desplazamientos
    --
    Importe: int
    Almuerzo: bool
}


Desplazamientos |o--||Visitas
Dietas |o--||Desplazamientos


entity DiasAsuntosPersonales {
    oid_DAP: int <<PK>>
    --
    inspector: int <<FK>> <<AK1>> -> Inspectores
    Curso: int <<AK1>>
    DiasSolicitados
    
    
}


entity Cursos {
    curso: string <<PK>>
    --
    inspector: int <<FK>> -> Inspectores
    DiasTotales

}

DiasAsuntosPersonales }o--||Cursos
DiasAsuntosPersonales }o--||Inspectores

'------- ASOCIACIONES --------------------------------------
DocumentosCita }o--|| Citas

@enduml
